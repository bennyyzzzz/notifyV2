# Notify v2 — environment variables (12-factor).
# Copy to `.env` for local development. NEVER commit `.env`.
# Every process validates these at startup and refuses to start if something is missing or weak.
# Secrets must come from a secret manager in staging/production.

# ── Common (api + worker) ───────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL 16 for the application role (no DDL). In production: ?sslmode=verify-full
# Local docker-compose example: postgresql://notify_app:<APP_DB_PASSWORD>@localhost:5432/notify
DATABASE_URL=
# Used only by `prisma migrate deploy` (role with DDL). Falls back to DATABASE_URL in development.
MIGRATION_DATABASE_URL=

# Redis 7. In production it must be TLS: rediss://
REDIS_URL=redis://localhost:6379

# Key-encryption keys for envelope encryption, format `keyId:base64(32 random bytes)`.
# Multiple keys (comma-separated) allow rotation; only the active one encrypts.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=k1

# Pepper (32 random bytes, base64) for hashing opaque tokens (refresh, invite, reset, server keys).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_PEPPER=

# Maximum time (ms) for graceful shutdown on SIGTERM.
SHUTDOWN_TIMEOUT_MS=25000

# ── API ─────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=3001
# Public base URL of the API (used in SDK snippets and OpenAPI). https in production.
PUBLIC_API_URL=http://localhost:3001
# Comma-separated origins allowed to call the authenticated API (scheme://host[:port]).
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 = trust none). Wrong values allow IP spoofing.
TRUST_PROXY_HOPS=0
# Global JSON body limit (bytes). Upload routes declare their own limits.
BODY_LIMIT_BYTES=102400
REQUEST_TIMEOUT_MS=15000
# Global per-IP rate limit (requests/minute). Sensitive routes have stricter limits.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
OPENAPI_ENABLED=false

# ── Worker ──────────────────────────────────────────────────────────────

WORKER_CONCURRENCY=10

# ── docker-compose (local only) ─────────────────────────────────────────

# Passwords for the local Postgres roles created by docker/postgres/init.sh.
POSTGRES_SUPERUSER_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
