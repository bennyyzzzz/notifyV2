{
  "name": "@notify/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "main": "dist/server.js",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi": "tsx src/scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@notify/crypto": "workspace:*",
    "@notify/db": "workspace:*",
    "@notify/shared": "workspace:*",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
}
