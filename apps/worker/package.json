{
  "name": "@notify/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@notify/crypto": "workspace:*",
    "@notify/db": "workspace:*",
    "@notify/shared": "workspace:*",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5"
  }
}
