// Notify v2 — data model (PROMPT_NOTIFY_V2.md §5)
//
// Conventions
// - Public ids are UUID v7; no auto-increment ids are exposed.
// - Tables and columns are snake_case in Postgres (@@map/@map).
// - Every business table carries organization_id (and app_id when applicable).
// - Cross-entity references are composite foreign keys that include app_id/organization_id,
//   so the database itself rejects links across tenants (V1-02, V1-03).
// - Hand-written SQL that Prisma cannot express (partial unique indexes, CHECKs, the
//   append-only audit trigger) lives in migrations/*_constraints and is documented in ADR 0004.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum PlatformRole {
  master
  none

  @@map("platform_role")
}

enum OrgRole {
  org_admin
  member

  @@map("org_role")
}

enum AppRole {
  admin
  operator
  viewer

  @@map("app_role")
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum UserStatus {
  invited
  active
  disabled

  @@map("user_status")
}

enum AppPlatform {
  web
  android
  ios
  flutter_webview

  @@map("app_platform")
}

enum FirebaseIntegrationStatus {
  pending_verification
  active
  failing
  revoked

  @@map("firebase_integration_status")
}

enum KeyStatus {
  active
  revoked

  @@map("key_status")
}

enum DeviceStatus {
  active
  invalid
  opted_out

  @@map("device_status")
}

enum CampaignTone {
  direto
  elegante
  divertido
  urgente
  premium
  jovem

  @@map("campaign_tone")
}

enum AudienceType {
  device
  token_list
  topic
  condition

  @@map("audience_type")
}

enum NotificationStatus {
  draft
  queued
  pending_approval
  scheduled
  sending
  sent
  partially_sent
  failed
  canceled

  @@map("notification_status")
}

enum DeliveryAttemptStatus {
  sent
  failed
  retrying

  @@map("delivery_attempt_status")
}

enum AutomationRunStatus {
  scheduled
  sent
  skipped
  canceled
  failed

  @@map("automation_run_status")
}

enum ActorType {
  user
  system
  api_key

  @@map("actor_type")
}

enum AiGenerationStatus {
  succeeded
  partial
  failed

  @@map("ai_generation_status")
}

// ───────────────────────── Identity & tenancy ─────────────────────────

model Organization {
  id        String             @id @default(uuid(7)) @db.Uuid
  name      String             @db.VarChar(120)
  slug      String             @unique @db.VarChar(63)
  status    OrganizationStatus @default(active)
  plan      String             @default("standard") @db.VarChar(40)
  settings  Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  members         OrganizationMember[]
  apps            App[]
  supportSessions SupportSession[]

  @@map("organizations")
}

model User {
  id                String       @id @default(uuid(7)) @db.Uuid
  name              String       @db.VarChar(120)
  /// Stored normalized (lower-case); CHECK (email = lower(email)) in migration.
  email             String       @unique @db.VarChar(254)
  /// argon2id hash; null while the invite is pending.
  passwordHash      String?      @map("password_hash") @db.VarChar(255)
  platformRole      PlatformRole @default(none) @map("platform_role")
  status            UserStatus   @default(invited)
  mfaSecretEnc      Bytes?       @map("mfa_secret_enc")
  mfaEnabledAt      DateTime?    @map("mfa_enabled_at") @db.Timestamptz(3)
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  failedLoginCount  Int          @default(0) @map("failed_login_count")
  lockedUntil       DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?    @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)

  memberships      OrganizationMember[]
  refreshTokens    RefreshToken[]
  oneTimeTokens    OneTimeToken[]
  recoveryCodes    MfaRecoveryCode[]
  supportSessions  SupportSession[]

  @@map("users")
}

model OrganizationMember {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole  @default(member)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  appMembers   AppMember[]

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model SupportSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  masterUserId   String    @map("master_user_id") @db.Uuid
  reason         String    @db.VarChar(500)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  masterUser   User         @relation(fields: [masterUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
  @@index([masterUserId])
  @@map("support_sessions")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum OneTimeTokenPurpose {
  invite
  password_reset

  @@map("one_time_token_purpose")
}

/// Invite and password-reset tokens (§5 PasswordResetToken / InviteToken). Only the hash is stored.
model OneTimeToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// ───────────────────────────── Apps ─────────────────────────────

model App {
  id                     String      @id @default(uuid(7)) @db.Uuid
  organizationId         String      @map("organization_id") @db.Uuid
  name                   String      @db.VarChar(80)
  platform               AppPlatform
  timezone               String      @default("America/Sao_Paulo") @db.VarChar(64)
  allowedRedirectDomains String[]    @default([]) @map("allowed_redirect_domains")
  allowedDeepLinkSchemes String[]    @default([]) @map("allowed_deep_link_schemes")
  utmDefaults            Json        @default("{}") @map("utm_defaults")
  contentLimits          Json        @default("{}") @map("content_limits")
  quietHours             Json        @default("{}") @map("quiet_hours")
  frequencyCaps          Json        @default("{}") @map("frequency_caps")
  allowedEvents          String[]    @default(["screen_view", "view_item", "add_to_cart", "session_start", "first_open", "initiate_checkout", "purchase"]) @map("allowed_events")
  createdById            String?     @map("created_by_id") @db.Uuid
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?   @map("deleted_at") @db.Timestamptz(3)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members              AppMember[]
  firebaseIntegrations FirebaseIntegration[]
  ingestKeys           IngestKey[]
  serverKeys           ServerKey[]
  devices              Device[]
  campaigns            Campaign[]
  notifications        Notification[]
  audienceLists        AudienceList[]
  deliveries           Delivery[]
  events               Event[]
  automationRules      AutomationRule[]
  aiGenerations        AiGeneration[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("apps")
}

model AppMember {
  organizationId String   @map("organization_id") @db.Uuid
  appId          String   @map("app_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           AppRole
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  app App @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// §7.1: a user can only join apps of an organization they belong to — enforced by this FK.
  orgMember OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)

  @@id([appId, userId])
  @@index([organizationId, userId])
  @@map("app_members")
}

// ─────────────────────── Integrations & keys ───────────────────────

model FirebaseIntegration {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  organizationId       String                    @map("organization_id") @db.Uuid
  appId                String                    @map("app_id") @db.Uuid
  name                 String                    @db.VarChar(80)
  projectId            String                    @map("project_id") @db.VarChar(100)
  clientEmail          String                    @map("client_email") @db.VarChar(254)
  privateKeyCiphertext Bytes                     @map("private_key_ciphertext")
  dekCiphertext        Bytes                     @map("dek_ciphertext")
  keyId                String                    @map("key_id") @db.VarChar(32)
  iv                   Bytes
  authTag              Bytes                     @map("auth_tag")
  status               FirebaseIntegrationStatus @default(pending_verification)
  lastVerifiedAt       DateTime?                 @map("last_verified_at") @db.Timestamptz(3)
  lastErrorCode        String?                   @map("last_error_code") @db.VarChar(64)
  consecutiveFailures  Int                       @default(0) @map("consecutive_failures")
  createdById          String?                   @map("created_by_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt            DateTime?                 @map("revoked_at") @db.Timestamptz(3)

  app             App              @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  notifications   Notification[]
  automationRules AutomationRule[]

  // Partial unique (app_id, project_id) WHERE revoked_at IS NULL is created in SQL.
  @@unique([id, appId])
  @@index([organizationId])
  @@index([appId, status])
  @@index([keyId])
  @@map("firebase_integrations")
}

model IngestKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appId          String    @map("app_id") @db.Uuid
  /// Publishable key (pk_live_… / pk_test_…). Public by nature; grants write-only event ingestion.
  publicKey      String    @unique @map("public_key") @db.VarChar(80)
  allowedOrigins String[]  @default([]) @map("allowed_origins")
  status         KeyStatus @default(active)
  lastEventAt    DateTime? @map("last_event_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  app    App     @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  events Event[]

  @@unique([id, appId])
  @@index([organizationId])
  @@index([appId, status])
  @@map("ingest_keys")
}

model ServerKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appId          String    @map("app_id") @db.Uuid
  keyPrefix      String    @unique @map("key_prefix") @db.VarChar(32)
  /// HMAC-SHA256(pepper, key). The key itself is shown once and never stored.
  keyHash        String    @map("key_hash") @db.VarChar(128)
  scopes         String[]  @default([])
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  app    App     @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  events Event[]

  @@unique([id, appId])
  @@index([organizationId])
  @@index([appId])
  @@map("server_keys")
}

// ─────────────────────────── End users ───────────────────────────

model Device {
  id                 String       @id @default(uuid(7)) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  appId              String       @map("app_id") @db.Uuid
  externalUserId     String?      @map("external_user_id") @db.VarChar(128)
  fcmTokenCiphertext Bytes        @map("fcm_token_ciphertext")
  /// HMAC of the token for dedupe/lookup without decrypting.
  fcmTokenHash       String       @map("fcm_token_hash") @db.VarChar(128)
  platform           AppPlatform
  consentAt          DateTime     @map("consent_at") @db.Timestamptz(3)
  consentSource      String       @map("consent_source") @db.VarChar(40)
  status             DeviceStatus @default(active)
  isTestDevice       Boolean      @default(false) @map("is_test_device")
  lastSeenAt         DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  app            App             @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  automationRuns AutomationRun[]

  @@unique([appId, fcmTokenHash])
  @@unique([id, appId])
  @@index([organizationId])
  @@index([appId, externalUserId])
  @@index([appId, status])
  @@map("devices")
}

// ─────────────────────── Campaigns & notifications ───────────────────────

model Campaign {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  appId          String       @map("app_id") @db.Uuid
  name           String       @db.VarChar(80)
  slug           String       @db.VarChar(100)
  theme          String       @db.VarChar(80)
  segment        String       @db.VarChar(60)
  tone           CampaignTone
  offer          Json         @default("{}")
  redirectUrl    String       @map("redirect_url") @db.VarChar(2048)
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  app           App            @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  notifications Notification[]
  aiGenerations AiGeneration[]

  @@unique([id, appId])
  @@index([organizationId])
  @@index([appId, createdAt])
  @@map("campaigns")
}

model Notification {
  id                    String             @id @default(uuid(7)) @db.Uuid
  organizationId        String             @map("organization_id") @db.Uuid
  appId                 String             @map("app_id") @db.Uuid
  campaignId            String?            @map("campaign_id") @db.Uuid
  automationRuleId      String?            @map("automation_rule_id") @db.Uuid
  firebaseIntegrationId String             @map("firebase_integration_id") @db.Uuid
  title                 String             @db.VarChar(65)
  body                  String             @db.VarChar(240)
  imageUrl              String?            @map("image_url") @db.VarChar(2048)
  redirectUrl           String             @map("redirect_url") @db.VarChar(2048)
  trackedUrl            String             @map("tracked_url") @db.VarChar(2048)
  data                  Json               @default("{}")
  audienceType          AudienceType       @map("audience_type")
  audienceRef           Json               @map("audience_ref")
  estimatedRecipients   Int                @default(0) @map("estimated_recipients")
  status                NotificationStatus @default(draft)
  scheduledAt           DateTime?          @map("scheduled_at") @db.Timestamptz(3)
  sentAt                DateTime?          @map("sent_at") @db.Timestamptz(3)
  canceledAt            DateTime?          @map("canceled_at") @db.Timestamptz(3)
  approvedById          String?            @map("approved_by_id") @db.Uuid
  approvedAt            DateTime?          @map("approved_at") @db.Timestamptz(3)
  rejectionReason       String?            @map("rejection_reason") @db.VarChar(500)
  idempotencyKey        String?            @map("idempotency_key") @db.VarChar(128)
  version               Int                @default(1)
  createdById           String?            @map("created_by_id") @db.Uuid
  updatedById           String?            @map("updated_by_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  app                 App                 @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  firebaseIntegration FirebaseIntegration @relation(fields: [firebaseIntegrationId, appId], references: [id, appId], onDelete: Restrict)
  /// Optional relations use single-column FKs; same-app membership is checked by the service layer (§6.3 rule 4)
  /// and by the trigger in the constraints migration.
  campaign            Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  automationRule      AutomationRule?     @relation(fields: [automationRuleId], references: [id], onDelete: Restrict)
  deliveries          Delivery[]

  @@unique([id, appId])
  @@unique([appId, idempotencyKey])
  @@index([organizationId])
  @@index([appId, status, createdAt])
  @@index([appId, scheduledAt])
  @@index([campaignId])
  @@index([automationRuleId])
  @@index([firebaseIntegrationId, appId])
  @@map("notifications")
}

model AudienceList {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  appId          String   @map("app_id") @db.Uuid
  name           String   @db.VarChar(80)
  size           Int      @default(0)
  invalidCount   Int      @default(0) @map("invalid_count")
  duplicateCount Int      @default(0) @map("duplicate_count")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  app     App                 @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  entries AudienceListEntry[]

  @@unique([id, appId])
  @@index([organizationId])
  @@index([appId, createdAt])
  @@map("audience_lists")
}

model AudienceListEntry {
  organizationId     String @map("organization_id") @db.Uuid
  appId              String @map("app_id") @db.Uuid
  audienceListId     String @map("audience_list_id") @db.Uuid
  fcmTokenCiphertext Bytes  @map("fcm_token_ciphertext")
  fcmTokenHash       String @map("fcm_token_hash") @db.VarChar(128)

  audienceList AudienceList @relation(fields: [audienceListId, appId], references: [id, appId], onDelete: Cascade)

  @@id([audienceListId, fcmTokenHash])
  @@index([audienceListId, appId])
  @@index([organizationId])
  @@map("audience_list_entries")
}

model Delivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appId          String    @map("app_id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  total          Int       @default(0)
  succeeded      Int       @default(0)
  failed         Int       @default(0)
  invalidTokens  Int       @default(0) @map("invalid_tokens")
  heartbeatAt    DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  app          App               @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  notification Notification      @relation(fields: [notificationId, appId], references: [id, appId], onDelete: Restrict)
  attempts     DeliveryAttempt[]

  @@unique([id, appId])
  @@index([organizationId])
  @@index([notificationId, appId])
  @@index([appId, startedAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  appId          String                @map("app_id") @db.Uuid
  deliveryId     String                @map("delivery_id") @db.Uuid
  /// Token hash, topic or condition — never a raw FCM token.
  target         String                @db.VarChar(1024)
  status         DeliveryAttemptStatus
  fcmMessageId   String?               @map("fcm_message_id") @db.VarChar(255)
  errorCode      String?               @map("error_code") @db.VarChar(64)
  attempt        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery Delivery @relation(fields: [deliveryId, appId], references: [id, appId], onDelete: Restrict)

  @@index([deliveryId, appId])
  @@index([deliveryId, target])
  @@index([organizationId, createdAt])
  @@map("delivery_attempts")
}

// ─────────────────────── Events & automations ───────────────────────

model Event {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  appId          String   @map("app_id") @db.Uuid
  ingestKeyId    String?  @map("ingest_key_id") @db.Uuid
  serverKeyId    String?  @map("server_key_id") @db.Uuid
  clientEventId  String?  @map("client_event_id") @db.Uuid
  name           String   @db.VarChar(64)
  externalUserId String?  @map("external_user_id") @db.VarChar(128)
  deviceId       String?  @map("device_id") @db.Uuid
  properties     Json     @default("{}")
  origin         String?  @db.VarChar(255)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  app       App        @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ingestKey IngestKey? @relation(fields: [ingestKeyId], references: [id], onDelete: Restrict)
  serverKey ServerKey? @relation(fields: [serverKeyId], references: [id], onDelete: Restrict)

  // Monthly partitioning is deferred to phase 6 (see ADR 0003).
  @@unique([appId, clientEventId])
  @@index([organizationId])
  @@index([appId, receivedAt])
  @@index([appId, name, receivedAt])
  @@index([appId, externalUserId, receivedAt])
  @@index([ingestKeyId])
  @@index([serverKeyId])
  @@map("events")
}

model AutomationRule {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  appId                 String    @map("app_id") @db.Uuid
  name                  String    @db.VarChar(80)
  slug                  String    @db.VarChar(100)
  triggerEvent          String    @map("trigger_event") @db.VarChar(64)
  conditions            Json      @default("[]")
  cancelOnEvents        String[]  @default([]) @map("cancel_on_events")
  delayMinutes          Int       @default(0) @map("delay_minutes")
  firebaseIntegrationId String    @map("firebase_integration_id") @db.Uuid
  title                 String    @db.VarChar(65)
  body                  String    @db.VarChar(240)
  redirectUrl           String    @map("redirect_url") @db.VarChar(2048)
  enabled               Boolean   @default(false)
  testMode              Boolean   @default(true) @map("test_mode")
  perUserCooldownHours  Int       @default(24) @map("per_user_cooldown_hours")
  createdById           String?   @map("created_by_id") @db.Uuid
  updatedById           String?   @map("updated_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  app                 App                 @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  firebaseIntegration FirebaseIntegration @relation(fields: [firebaseIntegrationId, appId], references: [id, appId], onDelete: Restrict)
  runs                AutomationRun[]
  notifications       Notification[]

  @@unique([id, appId])
  @@index([organizationId])
  @@index([appId, triggerEvent, enabled])
  @@index([firebaseIntegrationId, appId])
  @@map("automation_rules")
}

model AutomationRun {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  appId          String              @map("app_id") @db.Uuid
  ruleId         String              @map("rule_id") @db.Uuid
  eventId        String?             @map("event_id") @db.Uuid
  deviceId       String              @map("device_id") @db.Uuid
  status         AutomationRunStatus @default(scheduled)
  skipReason     String?             @map("skip_reason") @db.VarChar(64)
  scheduledFor   DateTime            @map("scheduled_for") @db.Timestamptz(3)
  executedAt     DateTime?           @map("executed_at") @db.Timestamptz(3)
  jobId          String?             @map("job_id") @db.VarChar(128)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  rule   AutomationRule @relation(fields: [ruleId, appId], references: [id, appId], onDelete: Restrict)
  device Device         @relation(fields: [deviceId, appId], references: [id, appId], onDelete: Cascade)

  @@index([ruleId, appId, scheduledFor])
  @@index([deviceId, appId, executedAt])
  @@index([organizationId])
  @@index([appId, status, scheduledFor])
  @@map("automation_runs")
}

// ─────────────────────────── AI & audit ───────────────────────────

model AiGeneration {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  appId          String             @map("app_id") @db.Uuid
  campaignId     String             @map("campaign_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  provider       String             @db.VarChar(40)
  model          String             @db.VarChar(80)
  inputTokens    Int                @default(0) @map("input_tokens")
  outputTokens   Int                @default(0) @map("output_tokens")
  costCents      Int                @default(0) @map("cost_cents")
  status         AiGenerationStatus
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  app      App      @relation(fields: [appId, organizationId], references: [id, organizationId], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId, appId], references: [id, appId], onDelete: Restrict)

  @@index([organizationId])
  @@index([appId, createdAt])
  @@index([userId, createdAt])
  @@index([campaignId, appId])
  @@map("ai_generations")
}

/// Append-only (§7.11). UPDATE/DELETE are blocked by trigger and by role grants.
model AuditLog {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  appId          String?   @map("app_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  action         String    @db.VarChar(64)
  targetType     String    @map("target_type") @db.VarChar(64)
  targetId       String?   @map("target_id") @db.VarChar(128)
  ip             String?   @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(512)
  correlationId  String    @map("correlation_id") @db.VarChar(64)
  /// Before/after diff, already redacted by the writer.
  changes        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([appId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
